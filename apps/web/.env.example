# Copy this file to .env and adjust values as needed.

# Postgres connection string (matches docker-compose.yml by default)
DATABASE_URL="postgresql://pento:pento@localhost:5434/pento_dev?schema=public"
# Direct (non-pooled) connection, used by Prisma migrations. Same value
# locally; on Neon/Vercel this must point at the unpooled connection string.
DATABASE_URL_UNPOOLED="postgresql://pento:pento@localhost:5434/pento_dev?schema=public"

# Payload CMS
# Generate a real secret with: openssl rand -hex 32
PAYLOAD_SECRET="changeme-generate-a-random-secret"

# Better Auth
# Generate a real secret with: npx @better-auth/cli secret
AUTH_SECRET="changeme-generate-with-npx-better-auth-cli-secret"
AUTH_URL="http://localhost:3000"

# Resend (https://resend.com/api-keys) - used to send transactional emails
RESEND_API_KEY="re_changeme"
EMAIL_FROM="Pento <onboarding@resend.dev>"

# Cloudinary (https://console.cloudinary.com/settings/c-global/api-keys) - product image delivery
# Cloud name only is needed to display/transform images; API key/secret are only
# required later if you add image uploads (e.g. an admin panel).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="changeme"

# Medusa (apps/medusa) - e-commerce backend (products, designers, tags, stock, inventory)
MEDUSA_BACKEND_URL="http://localhost:9000"
# From apps/medusa: npx medusa exec then GET /admin/api-keys, or check the admin dashboard
# under Settings > API Key Management > Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="pk_changeme"
# Admin user (created via `npx medusa user -e ... -p ...` from apps/medusa).
# Used server-side to query the admin API on a signed-in user's behalf (see
# src/lib/medusa-admin.ts, used for "Mes commandes" in /profile).
MEDUSA_ADMIN_EMAIL="admin@example.com"
MEDUSA_ADMIN_PASSWORD="changeme"