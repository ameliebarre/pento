{
  "name": "pento-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "web:dev": "turbo dev --filter=pento",
    "medusa:dev": "npm --prefix apps/medusa run dev",
    "medusa:install": "npm --prefix apps/medusa install",
    "medusa:lint": "npm --prefix apps/medusa run lint",
    "medusa:test": "npm --prefix apps/medusa run test:unit"
  },
  "devDependencies": {
    "turbo": "^2.0.14"
  }
}
