
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth — https://better-auth.com/docs/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  firstName     String?
  lastName      String?
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  accounts Account[]
  sessions Session[]
  orders   Order[]
  cart     Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Rate limiting — fixed-window counters, see src/lib/rate-limit.ts
// ---------------------------------------------------------------------------

model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}

// ---------------------------------------------------------------------------
// Media — one shared table so every image carries alt text (WCAG requirement,
// see CLAUDE.md accessibility rules), instead of bare URL strings scattered
// across models. Product uses it as a gallery (one-to-many, ordered via
// `position`); every other model uses it as a single cover/portrait/logo
// image (one-to-one, FK lives on the owning model).
// ---------------------------------------------------------------------------

model Image {
  id  String @id @default(cuid())
  url String
  alt String

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int?

  designer         Designer?
  manufacturerLogo Manufacturer?
  style            Style?
  material         Material?

  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Product catalog
// ---------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designer {
  id          String    @id @default(cuid())
  slug        String    @unique
  firstName   String
  lastName    String
  birthDate   DateTime?
  deathDate   DateTime?
  nationality String?
  biography   String    @db.Text
  quote       String?   @db.Text

  imageId String? @unique
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  products ProductDesigner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Country {
  id   String @id @default(cuid())
  name String @unique

  manufacturers Manufacturer[]
}

model Manufacturer {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  history String? @db.Text
  website String?

  logoId String? @unique
  logo   Image?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

model Style {
  id          String @id @default(cuid())
  slug        String @unique
  name        String @unique
  description String @db.Text

  coverImageId String? @unique
  coverImage   Image?  @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  description String? @db.Text

  imageId String? @unique
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  products ProductMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  products ProductTag[]

  createdAt DateTime @default(now())
}

model Product {
  id          String  @id @default(cuid())
  sku         String? @unique
  name        String
  slug        String  @unique
  description String  @db.Text
  price       Decimal @db.Decimal(10, 2)
  currency    String  @default("EUR")
  stock       Int     @default(0)
  salesCount  Int     @default(0)
  featured    Boolean @default(false)

  // Dimensions in centimeters, weight in kilograms.
  width  Float?
  height Float?
  depth  Float?
  weight Float?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])

  styleId String?
  style   Style?  @relation(fields: [styleId], references: [id])

  images    Image[]
  designers ProductDesigner[]
  materials ProductMaterial[]
  tags      ProductTag[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([styleId])
}

// --- Explicit join tables for Product's many-to-many relations -------------

model ProductDesigner {
  productId  String
  designerId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  designer Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@id([productId, designerId])
  @@index([designerId])
}

model ProductMaterial {
  productId  String
  materialId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
  @@index([materialId])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Cart & orders
// ---------------------------------------------------------------------------

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status          OrderStatus @default(PENDING)
  totalCents      Int
  currency        String      @default("EUR")
  shippingAddress String      @db.Text

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity       Int
  unitPriceCents Int
}
